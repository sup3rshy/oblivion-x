
Public Sub OblivionXJunkRoutine()
    Dim junkcounter As Long
    Dim junktext As String
    If False Then
        junktext = "decoy"
        junkcounter = 1 + 1
    End If
    Dim deadvarunused As Long
    If 1 = 2 Then
        deadvarunused = 999
    End If

End Sub
Attribute VB_Name = "NewMacros"
Public Function bwt1msm67xb(ByVal frs0swbone As String) As String
    bwt1msm67xb = Chr(Asc(frs0swbone) Xor 42)
End Function

Public Function OblivionXDecoy() As String
